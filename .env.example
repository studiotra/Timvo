# Supabase - get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (required for Stripe webhook to update invoice status)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend - https://resend.com (for sending invoice emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Set true in dev to allow payment links without Solo/Team tier
STRIPE_PAYMENTS_DEV_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# QuickBooks Online - https://developer.intuit.com
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (default) or production
QUICKBOOKS_ENVIRONMENT=sandbox

# OpenAI (optional, for AI Log Polisher) - https://platform.openai.com
OPENAI_API_KEY=sk-proj-xxx

# Slack - https://api.slack.com/apps (slash commands: /timvo)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional: used by Vercel Cron for 1h/2h timer alerts (falls back to SLACK_SIGNING_SECRET)
CRON_SECRET=

# Private desktop downloads (/download) — unlisted, access-code gated
DESKTOP_DOWNLOAD_ACCESS_CODE=change-me-to-a-long-secret
# Optional direct asset URLs (GitHub Release assets, CDN, etc.)
DESKTOP_DOWNLOAD_MAC_URL=
DESKTOP_DOWNLOAD_WIN_URL=
DESKTOP_DOWNLOAD_VERSION=0.1.0
DESKTOP_DOWNLOAD_RELEASES_URL=https://github.com/studiotra/Timvo/releases
